{
  "name": "grails-gradle-extension",
  "displayName": "DC-Grails-VS",
  "description": "Grails development for VS Code: breakpoints that actually bind in .groovy files, closures included, plus the Grails and Gradle commands.",
  "version": "0.1.6",
  "publisher": "gaolei8888",
  "engines": {
    "vscode": "^1.63.0"
  },
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gaolei8888/dc-grails-vs.git"
  },
  "keywords": [
    "grails",
    "groovy",
    "gradle",
    "debugger",
    "breakpoints",
    "gorm",
    "grails debug",
    "groovy debug"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onDebugResolve:groovy"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
        {
          "id": "groovy",
          "extensions": [ ".groovy" ],
          "aliases": [ "Groovy", "grails" ]
        }
      ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "grails",
          "title": "DC-Grails-VS",
          "icon": "media/grails.svg"
        }
      ]
    },
    "views": {
      "grails": [
        {
          "id": "grailsCommands",
          "name": "Commands",
          "when": "grails:isGrailsProject"
        }
      ]
    },
    "breakpoints": [
      {
        "language": "groovy"
      }
    ],
    "debuggers": [
      {
        "type": "groovy",
        "label": "Groovy (attach)",
        "languages": [
          "groovy"
        ],
        "configurationAttributes": {
          "attach": {
            "required": [
              "port"
            ],
            "properties": {
              "hostName": {
                "type": "string",
                "description": "Host the target JVM is listening on.",
                "default": "localhost"
              },
              "port": {
                "type": "number",
                "description": "JDWP port. Grails' bootRun --debug-jvm uses 5005.",
                "default": 5005
              },
              "timeout": {
                "type": "number",
                "description": "How long to keep retrying the attach, in milliseconds.",
                "default": 30000
              },
              "sourcePaths": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Roots to resolve stack frames against. Defaults to the Grails artefact directories of the workspace folder.",
                "default": []
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "groovy",
            "request": "attach",
            "name": "Attach to Grails (Groovy)",
            "hostName": "localhost",
            "port": 5005
          }
        ],
        "configurationSnippets": [
          {
            "label": "Groovy: attach to a running JVM",
            "description": "Binds breakpoints in .groovy files, closures included.",
            "body": {
              "type": "groovy",
              "request": "attach",
              "name": "Attach to Grails (Groovy)",
              "hostName": "localhost",
              "port": 5005
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Grails & Gradle",
      "properties": {
        "grails.run.command": {
          "type": "string",
          "default": "",
          "description": "Command line to start the app, instead of the Gradle wrapper. Use this when the project starts through a wrapper script that exports the environment the app needs (a run_dev.sh and the like); running gradlew directly loses all of it."
        },
        "grails.run.debugCommand": {
          "type": "string",
          "default": "",
          "description": "Command line for Grails: Debug App. Defaults to grails.run.command with --debug-jvm appended, which works for a wrapper that ends in `exec ./gradlew bootRun \"$@\"`."
        },
        "grails.run.env": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment variables to add for the app process. Merged over the environment VSCode itself was started with."
        },
        "grails.run.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments appended to the Gradle wrapper for bootRun. Ignored when grails.run.command is set."
        },
        "grails.debug.adapter": {
          "type": "string",
          "enum": [
            "groovy",
            "java"
          ],
          "enumDescriptions": [
            "This extension's own adapter. Binds breakpoints in .groovy files.",
            "Hand the session to vscjava.vscode-java-debug. Breakpoints in .groovy files stay unbound."
          ],
          "default": "groovy",
          "description": "Which debug adapter Grails: Debug App attaches with."
        },
        "grails.debug.javaPath": {
          "type": "string",
          "default": "",
          "description": "java executable used to run the Groovy debug adapter. Defaults to JAVA_HOME, then whatever is on PATH. Java 17 or later."
        }
      }
    },
